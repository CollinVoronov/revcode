# Trims the `railway up` upload. The Dockerfile's own exclusions live in
# .dockerignore; keep the two consistent so a file present in the upload but
# excluded from the image (or vice versa) never becomes a confusing build error.
#
# Load-bearing and deliberately NOT ignored: patches/, scripts/, assets/,
# pnpm-lock.yaml, pnpm-workspace.yaml, apps/, packages/, oxlint-plugin-t3code.
node_modules
**/node_modules

.git

apps/*/dist
packages/*/dist
infra/*/dist
dist-electron
.electron-runtime
release
release-mock
build

# Vendored reference checkouts: ~13k tracked files, ~126MB, unused by the build.
.repos

native/**/target

.t3
.turbo
.bun
.vite-hooks
.tanstack
.astro
.alchemy
.logs
.plans
.gstack
.showcase
apps/mobile/.showcase
**/__screenshots__
apps/web/.playwright
apps/web/playwright-report
artifacts
*.log
*.tsbuildinfo
.DS_Store

.env
.env.*
!.env.example
